
<mujoco model="contactforge_actuated_stage">
  <option timestep="0.001"
          gravity="0 0 -9.81"
          integrator="implicitfast"/>

  <worldbody>
    <geom name="ground"
          type="plane"
          size="2 2 0.1"/>

    <body name="stage" pos="0 0 0.1">
      <joint name="stage_slide"
             type="slide"
             axis="1 0 0"
             damping="1.0"/>

      <geom name="stage_geom"
            type="box"
            size="0.08 0.08 0.04"
            mass="0.5"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="stage_motor"
           joint="stage_slide"
           gear="1"
           ctrllimited="true"
           ctrlrange="-2 2"/>
  </actuator>
</mujoco>
