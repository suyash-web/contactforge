
<mujoco model="contactforge_controlled_indentation">

  <option timestep="0.001"
          gravity="0 0 0"
          integrator="implicitfast"
          iterations="100"/>

  <worldbody>

    <!-- A fixed spherical indenter -->
    <geom name="indenter_tip"
          type="sphere"
          pos="0 0 0.175"
          size="0.015"
          rgba="0.8 0.2 0.2 1"
          solref="0.005 1"/>

    <!-- Motor-driven vertical stage -->
    <body name="stage" pos="0 0 0.10">

      <joint name="stage_slide"
             type="slide"
             axis="0 0 1"
             damping="25"/>

      <geom name="stage_platform"
            type="box"
            size="0.08 0.08 0.015"
            mass="0.5"
            rgba="0.2 0.4 0.8 1"/>

      <!-- Compliant specimen mounted on stage -->
      <body name="sample" pos="0 0 0.025">

        <joint name="sample_compression"
               type="slide"
               axis="0 0 1"
               stiffness="1500"
               damping="15"
               springref="0"/>

        <geom name="sample_collision"
              type="box"
              size="0.04 0.04 0.01"
              mass="0.08"
              rgba="0.8 0.6 0.3 1"
              solref="0.005 1"/>

      </body>

    </body>

  </worldbody>

  <actuator>
    <position name="stage_motor"
              joint="stage_slide"
              kp="2000"
              ctrllimited="true"
              ctrlrange="0 0.05"/>
  </actuator>

</mujoco>
